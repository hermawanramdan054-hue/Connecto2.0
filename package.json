{
  "name": "test-connecto",
  "version": "1.0.0",
  "description": "Connecto App",
  "author": "Danncoek",
  "main": "main.js",

  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "pack": "electron-packager . ConnectoWiFi --platform=win32 --arch=x64 --out=dist --overwrite"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "open": "^11.0.2",
    "pdfkit": "^0.20.2",
    "ping": "^1.0.0",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "electron": "^25.9.8",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.connecto.app",
    "productName": "Connecto",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin/",
        "filter": [
          "**/*"
        ]
      }
    ],
           "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "cscLink": null,
      "requestedExecutionLevel": "requireAdministrator"
    },


       "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Connecto.setup.${ext}"
    }

  }
}
